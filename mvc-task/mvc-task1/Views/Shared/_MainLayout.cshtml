
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
</head>
<body class="d-flex flex-column min-vh-100">    <nav class="navbar navbar-expand-lg navbar-light bg-light">
          <div class="container-fluid">
            <a class="navbar-brand">University Cafeteria</a>
            <div class="collapse navbar-collapse" id="navbarNav">
              <ul class="navbar-nav">
                <li class="nav-item">
                  <a class="nav-link active" aria-current="page" asp-controller="Cafeteria" asp-action="Index">Home</a>
                </li>
                <li class="nav-item">
                  <a class="nav-link" asp-controller="Cafeteria" asp-action="Products">Products</a>
                </li>
                <li class="nav-item">
                  <a class="nav-link" asp-controller="Cafeteria" asp-action="Suppliers">Suppliers</a>
                </li>
                <li class="nav-item">
                  <a class="nav-link" asp-controller="Cafeteria" asp-action="SupplyStatus">Supply Status</a>
                </li>
              </ul>
            </div>
          </div>
    </nav>
    <main class="flex-grow-1">
        @RenderBody()
    </main>

<footer class="bg-dark text-white p-5">
    <p class="text-center mb-0">
        &copy; 2026 Company, Inc. All rights reserved.
    </p>
</footer>

@RenderSection("Scripts", required: false);
</body>
</html>
