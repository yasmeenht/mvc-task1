
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="d-flex flex-column min-vh-100">

    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <div class="container-fluid">

            <a class="navbar-brand" asp-controller="Supply" asp-action="Index">
                University Cafeteria
            </a>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Supply" asp-action="Index">
                            Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Supply" asp-action="Products">
                            Products
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Supply" asp-action="Suppliers">
                            Suppliers
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Supply" asp-action="CreateRequests">
                            Create Request
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Supply" asp-action="About">
                            About
                        </a>
                    </li>

                </ul>
            </div>
        </div>
    </nav>

    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="bg-dark text-white p-5">
        <p class="text-center mb-0">
            &copy; 2026 Company, Inc. All rights reserved.
        </p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
