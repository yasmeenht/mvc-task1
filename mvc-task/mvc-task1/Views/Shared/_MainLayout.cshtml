
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="d-flex flex-column min-vh-100">

    <a href="@Url.Action("Index", "Cafeteria")">Home</a>

    <a href="@Url.Action("Products", "Cafeteria")">Products</a>

    <a href="@Url.Action("Suppliers", "Cafeteria")">Suppliers</a>

    <a href="@Url.Action("Index", "SupplyRequest")">Create Supply Request</a>

    <a href="@Url.Action("Review", "SupplyRequest")">Review Draft</a>

    <a href="@Url.Action("MyRequests", "SupplyRequest")">My Requests</a>

    <a href="@Url.Action("About", "SupplyRequest")">About</a>

    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="bg-dark text-white p-5">
        <p class="text-center mb-0">
            &copy; 2026 Company, Inc. All rights reserved.
        </p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
