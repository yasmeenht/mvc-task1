@model List<mvc_task1.Models.SupplyRequest>

<h2>My Supply Requests</h2>

@if (Model.Count == 0)
{
    <p>No confirmed requests yet.</p>
}
else
{
    <table class="table table-bordered">
        <tr>
            <th>Request ID</th>
            <th>Products</th>
            <th>Subtotal</th>
            <th>Fee</th>
            <th>Discount</th>
            <th>Final Total</th>
            <th>Status</th>
        </tr>

        @foreach (var request in Model)
        {
            <tr>
                <td>@request.RequestId</td>
                <td>@request.Products.Count</td>
                <td>@request.Subtotal JD</td>
                <td>@request.Fee JD</td>
                <td>@request.Discount JD</td>
                <td>@request.FinalTotal JD</td>
                <td>@request.Status</td>
            </tr>
        }
    </table>
}
