@model List<mvc_task1.Models.Product>

<h2>Review Supply Request</h2>

@if (Model.Count == 0)
{
    <p>No products added yet.</p>
}
else
{
    <table class="table">
        <tr>
            <th>Product</th>
            <th>Quantity</th>
            <th>Unit Price</th>
            <th>Total</th>
        </tr>

        @foreach (var product in Model)
        {
            <tr>
                <td>@product.ProductName</td>
                <td>@product.Quantity</td>
                <td>@product.UnitPrice JD</td>
                <td>@(product.Quantity * product.UnitPrice) JD</td>
            </tr>
        }
    </table>

    <p>Subtotal: @ViewBag.Subtotal JD</p>
    <p>Preparation Fee: @ViewBag.Fee JD</p>
    <p>Discount: @ViewBag.Discount JD</p>

    <h3>Final Total: @ViewBag.FinalTotal JD</h3>

    <form method="post" asp-action="ConfirmRequest">
        <button type="submit">Confirm Request</button>
    </form>

    <a href="@Url.Action("ClearDraft", "SupplyRequest")">
        Clear Draft
    </a>
}

<a href="@Url.Action("Index", "SupplyRequest")">
    Add Another Product
</a>
