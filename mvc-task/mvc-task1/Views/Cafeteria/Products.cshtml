@{
}

@section Scripts{
    <script>
        alert("Welcome to Products Page!");
    </script>
    
}

@{
    string[] products = { "Water", "Orange Juice", "Coffee", "Sandwich", "Chocolate" };
}

<h1>Cafeteria Products</h1>

@if (products.Length < 3)
{
    <p>We need more products</p>
}
else
{
    <p>We have enough products</p>
    <ul>
    @foreach(string product in products)
    {
        <li>@product</li>
    }
    </ul>
}


<a asp-controller="cafeteria" asp-action="suppliers">Go To suppliers</a>
