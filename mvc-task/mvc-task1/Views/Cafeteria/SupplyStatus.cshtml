
@{
    Layout = null;

    string[] products = { "Water", "Orange Juice", "Coffee", "Sandwich", "Chocolate" };

    string[] suppliers = { "Fresh Food Company", "Happy Drinks Company", "Daily Supplies Company", "Fresh Food Company", "Daily Supplies Company" };

    int[] quantities = { 100, 20, 50, 0, 30 };

    string[] statuses = { "Available", "Low Stock", "Available", "Out of Stock", "Available" };
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cafeteria Supply Status</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head>

<body>

    <h1>Cafeteria Supply Status</h1>

    
<div class="container mt-4">
    

    
<div class="container mt-5">
    <div class="table-responsive">
        <table class="table table-striped table-hover table-bordered align-middle">
            <thead class="table-primary">
                <tr>
                    <th>Product</th>
                    <th>Supplier</th>
                    <th>Quantity</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>
                @for (int i = 0; i < products.Length; i++)
                {
                    <tr>
                        <td>@products[i]</td>
                        <td>@suppliers[i]</td>
                        <td>@quantities[i]</td>
                        <td>
                            @if (statuses[i] == "Available")
                            {
                                <span class="badge bg-success">Available</span>
                            }
                            else if (statuses[i] == "Low Stock")
                            {
                                <span class="badge bg-warning text-dark">Low Stock</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Out of Stock</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>



</div>

    <a asp-controller="Cafeteria" asp-action="Index">
        Go To Home
    </a>

</body>
</html>
