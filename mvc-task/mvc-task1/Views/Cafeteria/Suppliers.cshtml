@{
    Layout = "_SimpleLayout";
}
@{
    string[] suppliers = { "Fresh Food Company", "Happy Drinks Company", "Daily Supplies Company"};
}

<h1>Cafeteria Suppliers</h1>


<ul>
    @if (suppliers.Length > 2)
    {
        <p>We have enough suppliers</p>
        @foreach(string supplier in suppliers)
        {
            <li>@supplier</li>
        }
    }
    else
    {
        <p>We need more suppliers</p>
    }
</ul>
<a asp-controller="cafeteria" asp-action="SupplyStatus">Go To supply status</a>